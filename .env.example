# ============================================
# Fertility Center Cancun — variables de entorno
# Copia este archivo a .env.local y rellena los valores.
# ============================================

# --- Supabase (obligatorio) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Sitio ---
# Usada para canonical, hreflang, sitemap y RSS. Sin barra final.
NEXT_PUBLIC_SITE_URL=https://fertilitycentercancun.com

# --- Administración ---
# Lista separada por comas de correos con acceso al panel aunque no estén en la
# tabla `admin_users`. Útil para el arranque; el control real vive en la tabla
# (ver supabase-schema-admin-roles.sql).
ADMIN_EMAILS=

# --- Anti-spam (Cloudflare Turnstile) ---
# En producción el formulario se bloquea si no están configuradas.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Correo transaccional (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=Fertility Center Cancun <no-reply@fertilitycentercancun.com>
# Destinatario principal del aviso de lead. Por defecto comercial@afcc.com.mx.
LEAD_NOTIFICATION_TO=
# En copia. Por defecto info@fertilitycentercancun.com.mx. Separados por comas.
LEAD_NOTIFICATION_CC=
# Copias adicionales, se suman a LEAD_NOTIFICATION_CC y al correo configurado
# en el panel de administración.
LEAD_NOTIFICATION_EMAILS=

# --- Catálogo de donantes ---
# Buzón de la clínica para las consultas del catálogo. Vacío = van al mismo
# destinatario que el resto de formularios (LEAD_NOTIFICATION_TO o, en su
# defecto, comercial@afcc.com.mx). Rellénalo solo si la clínica lleva la
# donación en una dirección aparte. Separados por comas.
DONOR_LEAD_TO=
# Copia de las consultas del catálogo para el equipo de AltraVita, que gestiona
# el banco de donantes. Vacío = la lista acordada que está en el código
# (supermycolog@mail.ru, e_vinogradskaya@altravita.ru, 7909018@mail.ru y
# seo@altravita.ru), la misma para óvulos y esperma. Separados por comas.
DONOR_LEAD_CC=
# Solo si algún día vuelven a querer un buzón distinto por tipo de donante:
# estas dos mandan sobre DONOR_LEAD_CC. El destinatario NUNCA llega del
# formulario, se decide aquí en el servidor.
DONOR_LEAD_CC_EGG=
DONOR_LEAD_CC_SPERM=
# Token del endpoint que refresca el catálogo (/api/donors/refresh). Sin él, el
# endpoint responde 401 y el catálogo solo se renueva por caducidad (12 h).
# Genera uno con: openssl rand -hex 32
# El cron lo llama a las 08:05 hora de Cancún (UTC-5):
#   5 8 * * * curl -fsS -H "Authorization: Bearer $DONORS_REFRESH_TOKEN" \
#             https://fertilitycentercancun.com/api/donors/refresh
DONORS_REFRESH_TOKEN=

# --- CRM Upnify ---
# Una integración por idioma: el lead en español va a la ES y el inglés a la EN.
# Cada integración ya lleva su fase, origen y etiqueta configurados en el CRM,
# así que el sitio no los envía.
UPNIFY_INTEGRATION_URL_ES=
UPNIFY_INTEGRATION_URL_EN=
# Alternativa: solo el token, la URL se construye con UPNIFY_API_BASE_URL.
# Preferir siempre las variables *_URL_*: son las que aparecen tal cual en el CRM.
UPNIFY_INTEGRATION_TOKEN_ES=
UPNIFY_INTEGRATION_TOKEN_EN=
# Base para construir la URL desde un token. Las integraciones "API - Sistemas
# externos" no llevan el segmento /v4/ que sí usan las de Elementor.
UPNIFY_API_BASE_URL=https://api.salesup.com/integraciones
# Legacy: se usa si no hay configuración por idioma.
UPNIFY_INTEGRATION_URL=
UPNIFY_INTEGRATION_TOKEN=

# Campos personalizados de Upnify.
# El valor debe ser EXACTAMENTE la "etiqueta" que aparece en
# Ajustes > Campos personalizados: es el nombre real en la base de datos del CRM.
# Si no coincide, Upnify descarta el dato sin devolver error.
#
# El prefijo `cp.` que exige la API se añade solo, así que da igual escribir
# TRATAMIENTODEINTERES, [TRATAMIENTODEINTERES] o cp.TRATAMIENTODEINTERES.
# Los campos de sistema (nombre, correo, telefono, comentarios) no lo llevan.
# Mientras un campo esté vacío aquí, su dato viaja dentro de `comentarios`
# (se avisa en los logs del servidor).
#
# OJO: no sirven `tratamiento` ni `pais` como valores por defecto. `pais` es un
# campo de sistema de tipo lista, por eso todos los leads llegaban como "México";
# hay que crear un campo personalizado nuevo de tipo texto.
#
# Upnify duplica algunos campos por idioma ([QUETEDESCRIBEMEJOR] y
# [WHATDESCRIBESYOUBEST], por ejemplo). Si el campo de tratamiento sigue ese
# patrón, usa los sufijos _ES / _EN; si es un único campo bilingüe, usa la
# variable sin sufijo.
UPNIFY_TREATMENT_FIELD=
UPNIFY_TREATMENT_FIELD_ES=
UPNIFY_TREATMENT_FIELD_EN=
UPNIFY_COUNTRY_FIELD=
UPNIFY_PROMOTION_FIELD=

# Atribución de campañas. Cada utm_* va a su campo si está mapeado aquí; los que
# no, se agrupan en UPNIFY_UTM_FIELD. Si acabáis usando la integración nativa de
# Google Ads de Upnify, esto no hace falta.
UPNIFY_UTM_FIELD=
UPNIFY_UTM_SOURCE_FIELD=
UPNIFY_UTM_MEDIUM_FIELD=
UPNIFY_UTM_CAMPAIGN_FIELD=
UPNIFY_UTM_TERM_FIELD=
UPNIFY_UTM_CONTENT_FIELD=

# Solo si hace falta forzar el origen desde el sitio. Vacío = lo pone la
# integración del CRM, que es lo acordado.
UPNIFY_ORIGEN=

# --- CRM genérico (fallback si Upnify falla) ---
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=
# Si es 'true', un fallo de entrega al CRM se le reporta al usuario como error.
REQUIRE_CRM_DELIVERY=false

# --- Traducción automática de contenido dinámico (opcional) ---
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=

# --- Editor del panel (opcional) ---
NEXT_PUBLIC_TINYMCE_API_KEY=
